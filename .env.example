# Database
POSTGRES_DB=trace
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace_local_password
DATABASE_URL=postgresql+asyncpg://trace:trace_local_password@db:5432/trace

# Authentication
JWT_SECRET=change-this-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Storage
STORAGE_BACKEND=local

# Email
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@trace.local

# Frontend
VITE_API_URL=http://localhost:8000
