# TRACE — environment configuration (single source of truth).
# Copy to `.env` (gitignored — never commit real values) and edit.

# Database (Phase 1 — local Postgres container)
POSTGRES_DB=trace
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace_local_password

# Authentication
# 45-char dev secret (>=32 bytes recommended for HS256); replace for any real deployment.
JWT_SECRET=change-this-development-secret-0123456789-abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Storage (Phase 1)
# Selects the active storage implementation: `local` (LocalDiskStorage) now,
# `supabase` in Phase 2 (requires the SUPABASE_* vars in the Phase 2 block).
STORAGE_BACKEND=local
# LocalDiskStorage root for host-side runs (the compose container pins
# /app/uploads regardless of this value).
UPLOAD_DIR=backend/uploads

# Email (Phase 1)
# Selects the active email implementation: `smtp` (local Mailpit) now,
# `resend` in Phase 2 (requires RESEND_API_KEY in the Phase 2 block).
# SMTP_HOST is `mailpit` for the compose-network backend container (Module 8),
# `localhost` when the backend runs on the host (Phase 1).
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@trace.local

# Frontend
VITE_API_URL=http://localhost:8000

# ============================================================================
# Phase 2 (optional) — cloud migration, pre-deployment wiring (Module 9)
# ----------------------------------------------------------------------------
# docker-compose.override.yml is AUTO-LOADED by plain `docker compose up` /
# `make demo` — there is no separate hybrid-mode command, and no -f flag is
# needed. Hybrid mode is controlled ENTIRELY by what is set in this .env.
# Leaving every var below unset/empty preserves the exact Phase 1 behavior
# above even though the override file is always loaded.
#
# Real values belong ONLY in this gitignored .env — never in committed files
# (.env.example, docker-compose.override.yml, etc. are placeholder-only).
# ============================================================================

# Database -> external Postgres (e.g. Supabase). Unset = the local db
# container. Host-side Phase-1 tools (alembic, seed) fall back to the
# identical local URL in backend/app/config.py, so this stays commented in
# Phase 1.
#DATABASE_URL=postgresql+psycopg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# File storage -> Supabase. Set STORAGE_BACKEND=supabase above (independently
# of EMAIL_BACKEND — a hybrid "Supabase DB + local Mailpit" stays possible).
#SUPABASE_URL=https://<project-ref>.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
#SUPABASE_STORAGE_BUCKET=trace-uploads

# Email -> Resend. Set EMAIL_BACKEND=resend above.
#RESEND_API_KEY=re_<api-key>