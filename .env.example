[TEMPLATE]
# Database
POSTGRES_DB=trace
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace_local_password
# Host is `localhost` when running tools on the host (Milestone 1: alembic/seed);
# use `db` for a service on the compose network (Milestone 8: backend container).
DATABASE_URL=postgresql+psycopg://trace:trace_local_password@localhost:5432/trace

# Authentication
# 45-char dev secret (>=32 bytes recommended for HS256); replace for any real deployment.
JWT_SECRET=change-this-development-secret-0123456789-abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Storage
STORAGE_BACKEND=local
# LocalDiskStorage root (default: backend/uploads/ relative to the backend package)
UPLOAD_DIR=backend/uploads

# Email (Module 6)
# Host is `localhost` when running the backend on the host (Phase 1);
# use `mailpit` for the backend service on the compose network (Module 8).
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@trace.local

# Frontend
VITE_API_URL=http://localhost:8000
