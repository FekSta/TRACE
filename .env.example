# TRACE — environment configuration (single source of truth, Retrofit 2026-09-08)
#
# Copy this file to `.env` (gitignored) and edit values as needed:
#     cp .env.example .env
# Every variable below is read from `.env` by docker-compose.yml, the backend
# config loader (backend/app/config.py — required, fail-fast), or the frontend
# build (via docker-compose `build.args`). There are deliberately NO hardcoded
# fallback values elsewhere; see Notes.md §2.1 and Review.md Retrofit for the
# canonical reference. Phase 2 (cloud) swaps values here only — no code changes.

# Database ----------------------------------------------------------------
POSTGRES_DB=trace
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace_local_password
# Host-side only (Alembic, seed, host uvicorn): host is `localhost`. The
# docker-compose backend container builds its OWN URL from the POSTGRES_* vars
# with host `db` — this value never reaches the container (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://trace:trace_local_password@localhost:5432/trace

# Authentication -----------------------------------------------------------
# 48-char dev secret (>=32 bytes recommended for HS256); replace for any real deployment.
JWT_SECRET=change-this-development-secret-0123456789-abcdef
JWT_EXPIRE_MINUTES=60

# Storage (Module 3) --------------------------------------------------------
# Phase 1 = `local` (LocalDiskStorage). Module 9 reads this to select SupabaseStorage.
STORAGE_BACKEND=local
# LocalDiskStorage root for host-side runs — resolved relative to the backend
# working dir, so `uploads` lands at backend/uploads/ (the compose container
# pins /app/uploads regardless of this value).
UPLOAD_DIR=uploads

# Email (Module 6) ----------------------------------------------------------
# Phase 1 sends only to the local Mailpit catcher. `localhost` works for a
# host-side backend (Mailpit publishes SMTP on localhost:1025); the compose
# container pins `mailpit` (compose-network hostname) — see docker-compose.yml.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@trace.local

# Frontend (Module 7) --------------------------------------------------------
# Build-time value: docker-compose passes this to the frontend image via
# `build.args` -> Dockerfile ARG -> vite build. Host dev reads frontend/.env
# (frontend/.env.example) instead.
VITE_API_URL=http://localhost:8000
