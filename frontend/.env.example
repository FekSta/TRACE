# TRACE Phase 1: the FastAPI backend runs locally on :8000.
#
# This file is for HOST-side dev (`npm run dev`). Copy it to `frontend/.env`
# (gitignored via the repo-root .gitignore `.env` rule).
#
# The dockerized build does NOT read this file: docker-compose.yml passes
# VITE_API_URL from the REPO-ROOT `.env` through `build.args` into the
# Dockerfile ARG, so the built bundle and `npm run dev` always agree.
# Single source of truth: Review.md Retrofit 2026-09-08.
VITE_API_URL=http://localhost:8000